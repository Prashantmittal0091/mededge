# MedEdge Intelligence - Production Environment Configuration Template

# Database Connection String (Render PostgreSQL / Supabase / Railway)
# If left unset or empty, MedEdge Intelligence defaults to local SQLite (mededge.db)
DATABASE_URL=postgresql://mededge_user:password_here@dpg-xxxxxx.render.com/mededgedb

# Application JWT Secret Key (Provide a secure random string in production)
SECRET_KEY=change_this_to_a_secure_random_production_secret_key_2026

# Allowed Frontend Origin (For production CORS setup)
FRONTEND_URL=https://mededge-intelligence.onrender.com

# Optional Local SLM (Ollama) Endpoint (Default: http://localhost:11434/api/generate)
OLLAMA_URL=http://localhost:11434/api/generate
